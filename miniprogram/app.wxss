/* app.wxss - 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 通用卡片样式 */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 按钮样式 */
.btn-primary {
  background: #07c160;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-primary::after {
  border: none;
}

.btn-danger {
  background: #ff4d4f;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-danger::after {
  border: none;
}

.btn-secondary {
  background: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.btn-secondary::after {
  border: none;
}

/* 状态标签 */
.status-paid {
  background: #e8f5e9;
  color: #07c160;
}

.status-pending {
  background: #ffebee;
  color: #ff4d4f;
}

.status-vacant {
  background: #f5f5f5;
  color: #999;
}

.status-upcoming {
  background: #fff3e0;
  color: #ff9800;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}