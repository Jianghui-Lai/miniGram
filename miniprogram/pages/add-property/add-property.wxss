.container {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.form-card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.form-item {
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
}

.label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.label.required::before {
  content: '*';
  color: #ff4d4f;
  margin-right: 6rpx;
}

.input {
  width: 100%;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 1.4;
}

.picker {
  width: 100%;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
}

.textarea {
  width: 100%;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 160rpx;
  line-height: 1.5;
}

.error {
  font-size: 22rpx;
  color: #ff4d4f;
  margin-top: 8rpx;
  display: block;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
}

.cancel-btn, .save-btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #ddd;
}

.save-btn {
  background: #07c160;
  color: white;
  border: 2rpx solid #07c160;
}

.save-btn.disabled {
  background: #b3e6cc;
}

.cancel-btn::after, .save-btn::after {
  border: none;
}