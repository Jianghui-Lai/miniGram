/* 历史记录页面样式 */
.container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 月份选择器区域 */
.month-section {
  background: linear-gradient(135deg, #07c160, #0a9e4f);
  padding: 40rpx 30rpx;
  color: white;
}

.month-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.2);
  padding: 20rpx 30rpx;
  border-radius: 60rpx;
  backdrop-filter: blur(10px);
}

.month-display {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 500;
}

.arrow {
  font-size: 28rpx;
  margin-left: 10rpx;
  opacity: 0.8;
}

.month-nav {
  display: flex;
  gap: 30rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: bold;
}

/* 汇总卡片 */
.summary-card {
  background: white;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.summary-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.summary-numbers {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.summary-item {
  text-align: center;
  flex: 1;
}

.summary-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.summary-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.summary-value.paid {
  color: #07c160;
}

.summary-value.pending {
  color: #ff4d4f;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.filter-tab {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  border-radius: 30rpx;
  background: #f5f5f5;
  color: #666;
}

.filter-tab.active {
  background: #07c160;
  color: white;
}

/* 明细列表 */
.detail-list {
  margin: 0 30rpx;
}

.detail-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s;
}

.detail-item:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.detail-left {
  flex: 1;
}

.address {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.tenant {
  font-size: 26rpx;
  color: #666;
  display: block;
}

.payment-info {
  margin-top: 10rpx;
}

.payment-date {
  font-size: 22rpx;
  color: #999;
}

.detail-right {
  text-align: right;
}

.amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #07c160;
  display: block;
  margin-bottom: 10rpx;
}

.status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.paid {
  background: #e8f5e9;
  color: #07c160;
}

.status-badge.pending {
  background: #ffebee;
  color: #ff4d4f;
}

/* 收据照片 */
.receipt-thumb {
  margin-top: 20rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.receipt-image {
  width: 100%;
  height: 100%;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 导出按钮 */
.export-btn {
  position: fixed;
  bottom: 30rpx;
  right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  background: #07c160;
  color: white;
  border-radius: 50%;
  text-align: center;
  line-height: 100rpx;
  font-size: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

/* 年份快速跳转 */
.year-jump {
  margin: 20rpx 30rpx;
  white-space: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  padding: 10rpx 0;
}

.year-item {
  display: inline-block;
  padding: 10rpx 30rpx;
  background: white;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.year-item.active {
  background: #07c160;
  color: white;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.detail-item {
  animation: fadeIn 0.3s ease;
}

/* 深色模式适配（可选） */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #1a1a1a;
  }
  
  .summary-card,
  .detail-item,
  .year-item {
    background-color: #2a2a2a;
    color: #fff;
  }
  
  .address {
    color: #fff;
  }
  
  .tenant,
  .summary-label {
    color: #999;
  }
}