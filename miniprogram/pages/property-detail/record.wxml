<view class="container">
  <!-- 月份选择器 -->
  <picker mode="date" 
          fields="month" 
          value="{{selectedMonth}}"
          bindchange="onMonthChange">
    <view class="month-selector">
      <text>{{displayMonth}}</text>
      <text class="arrow">▼</text>
    </view>
  </picker>

  <!-- 当月收款汇总 -->
  <view class="month-summary">
    <view class="summary-row">
      <text>当月应收：</text>
      <text>{{monthSummary.total}}元</text>
    </view>
    <view class="summary-row">
      <text>当月已收：</text>
      <text class="paid">{{monthSummary.paid}}元</text>
    </view>
    <view class="summary-row">
      <text>当月未收：</text>
      <text class="pending">{{monthSummary.pending}}元</text>
    </view>
  </view>

  <!-- 当月交租明细 -->
  <view class="detail-list">
    <view class="detail-item" 
          wx:for="{{monthDetails}}" 
          wx:key="id">
      <view class="detail-left">
        <text class="address">{{item.address}}</text>
        <text class="tenant">{{item.tenant}}</text>
      </view>
      <view class="detail-right">
        <text class="amount">{{item.amount}}元</text>
        <view class="status {{item.isPaid ? 'paid' : 'pending'}}">
          {{item.isPaid ? '已交' : '未交'}}
        </view>
      </view>
    </view>
  </view>
</view>