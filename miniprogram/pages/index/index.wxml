<view class="container">
  <!-- 统计卡片 -->
  <view class="summary-card">
    <view class="summary-header">
      <text class="summary-title">{{currentMonth}}</text>
      <!-- 红点提醒 -->
      <view class="reminder-badge" wx:if="{{pendingCount > 0}}">
        <text class="reminder-text">{{pendingCount}}套待收租</text>
      </view>
    </view>
    
    <view class="summary-stats">
      <view class="stat-item">
        <text class="stat-label">本月应收</text>
        <text class="stat-value">{{totalRent}}元</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">已收</text>
        <text class="stat-value paid">{{paidRent}}元</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">未收</text>
        <text class="stat-value pending">{{pendingRent}}元</text>
      </view>
    </view>
  </view>

  <!-- 出租中房产列表 -->
  <view class="section-header">
    <text class="section-title">🏠 出租中 ({{properties.length}}套)</text>
  </view>

  <view class="property-list">
    <block wx:if="{{properties.length > 0}}">
      <view class="property-item" 
            wx:for="{{properties}}" 
            wx:key="id"
            bindtap="goToPropertyDetail" 
            data-id="{{item.id}}">
        
        <view class="property-info">
          <view class="property-address">{{item.address}}</view>
          <view class="property-rent">{{item.monthlyRent}}元/月</view>
          <view class="property-lease" wx:if="{{item.leaseStart}}">
            📅 {{item.leaseStart}} 至 {{item.leaseEnd}}
          </view>
          <view class="property-tenant" wx:if="{{item.tenantName}}">
            租客：{{item.tenantName}}
          </view>
        </view>
        
        <view class="property-right">
          <!-- 状态灯 -->
          <view class="status-light {{item.isPaid ? 'paid' : 'pending'}}">
            {{item.isPaid ? '已交租' : '未交租'}}
          </view>
          
          <!-- 收租按钮 -->
          <button class="collect-btn" 
                  wx:if="{{!item.isPaid}}"
                  catchtap="collectRent"
                  data-property="{{item}}">
            收租
          </button>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-icon">🏠</text>
      <text class="empty-text">暂无出租中的房产</text>
    </view>
  </view>

  <!-- 添加房产按钮 -->
  <!-- 添加房产按钮 - 底部中间加号图标 -->
<view class="add-fab" bindtap="goToAddProperty">
  <text class="add-icon">+</text>
</view>
</view>